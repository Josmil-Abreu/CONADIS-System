<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CONADIS.Integracion.Negocio: lógica del módulo de Integración (el SND).
      Datos/        -> acceso a SQL Server solo con Stored Procedures (copia de la del Core)
      Logging/      -> Log4Net (archivo + tabla Log4NetLog)
      Seguridad/    -> API keys, huellas HMAC de cédulas, contraseñas de operadores
      Modelos/      -> objetos que devuelven los repositorios y servicios
      Repositorios/ -> un repositorio por tabla de la base CONADIS_IntegracionDB
      Resiliencia/  -> reintentos, tiempo de espera, cortacircuito y bitácora (RIC-06)
      Externos/     -> adaptadores (simulados) de JCE, MSP, DGII, firma, pasarela y correo
      Servicios/    -> casos de uso: identidad, diagnóstico, firma, verificación, portal, pagos, cola
    No referencia ningún proyecto del Core: se comunica con él solo por su API REST (ClienteCore).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CONADIS.Integracion.Negocio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Reportes RDLC en .NET moderno (el ReportViewer clásico solo existe para .NET Framework) -->
    <PackageReference Include="ReportViewerCore.NETCore" Version="15.1.22" />
    <!-- ReportViewerCore trae versiones viejas con avisos de seguridad (NU1902/NU1903): se fijan las corregidas -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CONADIS.Integracion.Pruebas" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los diseños .rdlc viajan dentro de la DLL: GeneradorReportes los lee como recurso incrustado -->
    <EmbeddedResource Include="Reportes\*.rdlc" />
  </ItemGroup>

</Project>
