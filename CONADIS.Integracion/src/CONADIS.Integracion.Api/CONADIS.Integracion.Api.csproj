<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    CONADIS.Integracion.Api: el SND (Sistema Nervioso Digital). Única puerta entre los canales
    (Portal Web, Caja), las instituciones con convenio y el Core.
      Controladores/    -> Portal, Caja, Firma (para el Core), Verificación y Salud
      Seguridad/        -> autenticación por API key contra seg.ClienteApi + políticas por ámbito
      Infraestructura/  -> errores ProblemDetails, correlación e idempotencia (Idempotency-Key)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CONADIS.Integracion.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CONADIS.Integracion.Negocio\CONADIS.Integracion.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
