@model FacturaCaja
<section class="receipt">@if(Model.EsPrueba){<div class="demo">COMPROBANTE DE PRUEBA · SIN VALIDEZ FISCAL</div>}<p class="eyebrow">CONADIS · @Model.Tipo</p><h1>@Model.ENcf</h1><p>@Model.Fecha.ToString("g") · @Model.EstadoDgii</p><h2>@Model.Cliente</h2><p>@Model.Documento</p><dl><dt>Concepto</dt><dd>@Model.Concepto × @Model.Cantidad</dd><dt>Subtotal</dt><dd>@Model.Subtotal.ToString("C")</dd><dt>Impuesto</dt><dd>@Model.Itbis.ToString("C")</dd><dt>Total</dt><dd class="total">@Model.Total.ToString("C")</dd><dt>Medio</dt><dd>@Model.Medio</dd><dt>Recibido</dt><dd>@Model.Recibido.ToString("C")</dd><dt>Cambio</dt><dd>@Model.Cambio.ToString("C")</dd><dt>Código de seguridad</dt><dd>@Model.CodigoSeguridad</dd></dl><p>@Model.MensajeDgii</p><a asp-action="Reporte" asp-route-tipo="comprobante" asp-route-id="@Model.Id" accesskey="p">Descargar representación PDF (SSRS)</a><p><a asp-action="Reporte" asp-route-tipo="termico" asp-route-id="@Model.Id">Formato térmico 80 mm (SSRS)</a></p><p><a asp-action="Index" accesskey="x">Volver a caja</a></p></section>