@{
 Actor actor=ViewBag.Actor; string vista=ViewBag.Vista; List<SesionCaja> sesiones=ViewBag.Sesiones; List<Tasa> tasas=ViewBag.Tasas; List<OrdenCobro> ordenes=ViewBag.Ordenes; List<FacturaCaja> facturas=ViewBag.Facturas; List<NotaCredito> notas=ViewBag.Notas; List<SecuenciaENcf> secuencias=ViewBag.Secuencias;
 var abierta=sesiones.FirstOrDefault(x=>x.Estado==EstadoSesion.Abierta && x.Cajero==actor.Id); bool supervisor=actor.Rol=="SupervisorCaja";
}
@if(ViewBag.Demo){<div class="demo">DEMOSTRACIÓN · Datos ficticios · Comprobantes sin validez fiscal</div>}
<div class="heading"><div><p class="eyebrow">@actor.Sucursal · @ViewBag.Hoy</p><h1>Control de caja</h1><p>Registra cobros y completa el cierre de tu jornada.</p></div><span class="badge">@(supervisor?"Supervisión":abierta==null?"Sin caja abierta":"Caja "+abierta.Caja)</span></div>
<nav aria-label="Funciones de caja"><a asp-action="Index" asp-route-vista="cobros" aria-current="@(vista=="cobros"?"page":null)">Cobros</a><a asp-route-vista="arqueo" aria-current="@(vista=="arqueo"?"page":null)">Arqueo y cierre</a><a asp-route-vista="comprobantes" aria-current="@(vista=="comprobantes"?"page":null)">Comprobantes</a><a asp-route-vista="reportes" aria-current="@(vista=="reportes"?"page":null)">Reportes</a>@if(supervisor){<a asp-route-vista="configuracion" aria-current="@(vista=="configuracion"?"page":null)">Catálogo y secuencias</a>}</nav>
@if(vista=="cobros" && !supervisor){
 if(abierta==null){<section><h2>Abrir caja</h2><p>Registra el fondo inicial por denominación.</p><form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="abrir"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><label for="Caja">Identificador de caja</label><input id="Caja" name="Caja" required maxlength="60" placeholder="CAJA-01"/><partial name="_Denominaciones"/><button>Abrir sesión</button></form></section>}
 else{<div class="columns"><section><h2>Cobrar una orden</h2><p>El importe se calcula con la tasa vigente. Atajo: Alt+C.</p><form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="cobrar"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><input type="hidden" name="SesionId" value="@abierta.Id"/><label for="orden">Orden pendiente</label><select id="orden" name="Id" required><option value="">Selecciona la orden</option>@foreach(var o in ordenes){var t=tasas.FirstOrDefault(x=>x.Id==o.TasaId);<option value="@o.Id">@o.Numero · @o.Nombre · @(t==null?"Tasa vencida":((t.Precio*o.Cantidad)+Money.Round(t.Precio*o.Cantidad*t.Impuesto)).ToString("C"))</option>}</select><label for="Medio">Medio de pago</label><select id="Medio" name="Medio"><option value="Efectivo">Efectivo</option><option value="Tarjeta">Tarjeta / POS</option><option value="Transferencia">Transferencia</option><option value="EnLinea">Pago en línea</option></select><label for="Recibido">Efectivo recibido (DOP)</label><input id="Recibido" name="Recibido" type="number" min="0" step="0.01" value="0" required/><label for="Referencia">Referencia de autorización (para pagos no efectivos)</label><input id="Referencia" name="Referencia" maxlength="100"/><button accesskey="c" data-confirm="¿Confirmas el cobro y la emisión del comprobante?">Confirmar cobro</button></form></section>
 <section><h2>Nueva orden de cobro</h2><p>Solo servicios sujetos a tasas. El carnet inicial y la certificación de discapacidad son gratuitos.</p><form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="orden"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><label for="TasaId">Servicio</label><select id="TasaId" name="TasaId">@foreach(var t in tasas){<option value="@t.Id">@t.Descripcion · @t.Precio.ToString("C")</option>}</select><label for="Cantidad">Cantidad</label><input id="Cantidad" name="Cantidad" type="number" min="1" max="1000" value="1"/><label for="Documento">Cédula o RNC</label><input id="Documento" name="Documento" inputmode="numeric" pattern="[0-9]{9}|[0-9]{11}" required/><label for="Nombre">Nombre o razón social</label><input id="Nombre" name="Nombre" required maxlength="200" autocomplete="name"/><label for="Tipo">Tipo de comprobante</label><select name="Tipo" id="Tipo"><option value="E32">E32 · Consumo</option><option value="E31">E31 · Crédito fiscal</option><option value="E45">E45 · Gubernamental</option></select><label for="tramite">Referencia del trámite (opcional)</label><input id="tramite" name="Referencia" maxlength="100"/><button class="secondary">Crear orden</button></form></section></div>}
}
@if(vista=="cobros" && supervisor){<section><h2>Seguimiento de la jornada</h2><p>@sesiones.Count(x=>x.Estado==EstadoSesion.PendienteAprobacion) cierres pendientes de aprobación.</p><p>@facturas.Count(x=>x.EstadoDgii is EstadoDgii.Contingencia or EstadoDgii.Rechazado or EstadoDgii.AceptadoCondicional) comprobantes requieren seguimiento en la lista reciente.</p><a asp-route-vista="arqueo">Revisar cierres</a> · <a asp-route-vista="comprobantes">Revisar comprobantes</a></section>}
@if(vista=="arqueo"){
 if(!supervisor && abierta!=null){<section><h2>Arqueo ciego</h2><p>Cuenta el efectivo y declara los comprobantes. Los totales esperados se mostrarán después de enviar este conteo. Al enviarlo se bloquearán nuevos cobros.</p><form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="arquear"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><input type="hidden" name="Id" value="@abierta.Id"/><partial name="_Denominaciones"/><div class="fields">@foreach(var field in new[]{"Tarjeta","Transferencia","EnLinea"}){<div><label for="@field">@(field=="EnLinea"?"Pagos en línea":field) declarados (DOP)</label><input id="@field" name="@field" type="number" min="0" step="0.01" value="0" required/></div>}</div><button data-confirm="El conteo se bloqueará para revisión. ¿Deseas enviarlo?">Firmar y enviar arqueo</button></form></section>}
 foreach(var s in sesiones.OrderByDescending(x=>x.Fecha)){<section><h2>@s.Caja · @s.Cajero <span class="badge">@s.Estado</span></h2><p>Jornada: @s.Fecha</p>@if(s.Estado!=EstadoSesion.Abierta){<div class="table-wrap"><table><caption>Diferencias del arqueo enviado</caption><thead><tr><th>Medio</th><th>Declarado</th><th>Diferencia</th></tr></thead><tbody><tr><td>Efectivo</td><td>@s.DeclaradoEfectivo?.ToString("C")</td><td>@s.DiferenciaEfectivo?.ToString("C")</td></tr><tr><td>Tarjeta</td><td>@s.DeclaradoTarjeta?.ToString("C")</td><td>@s.DiferenciaTarjeta?.ToString("C")</td></tr><tr><td>Transferencia</td><td>@s.DeclaradoTransferencia?.ToString("C")</td><td>@s.DiferenciaTransferencia?.ToString("C")</td></tr><tr><td>En línea</td><td>@s.DeclaradoEnLinea?.ToString("C")</td><td>@s.DiferenciaEnLinea?.ToString("C")</td></tr></tbody></table></div>}
 @if(supervisor&&s.Estado==EstadoSesion.PendienteAprobacion){<form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="cerrar"/><input type="hidden" name="Id" value="@s.Id"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><label for="motivo-@s.Id">Justificación de diferencias / observaciones</label><textarea name="Motivo" id="motivo-@s.Id" maxlength="1000"></textarea><button data-confirm="¿Apruebas y firmas este cierre?">Aprobar y firmar cierre</button></form>}
 @if(supervisor&&s.Estado!=EstadoSesion.Cerrada&&s.Fecha<(DateOnly)ViewBag.Hoy){<details><summary>Cierre administrativo de sesión vencida</summary><p>El conteo será registrado por el supervisor y quedará constancia de la ausencia de firma del cajero.</p><form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="forzar-cierre"/><input type="hidden" name="Id" value="@s.Id"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><partial name="_Denominaciones"/><label>Tarjetas declaradas<input type="number" name="Tarjeta" min="0" step="0.01" value="0"/></label><label>Transferencias declaradas<input type="number" name="Transferencia" min="0" step="0.01" value="0"/></label><label>Pagos en línea declarados<input type="number" name="EnLinea" min="0" step="0.01" value="0"/></label><label>Motivo del cierre administrativo<textarea name="Motivo" required maxlength="1000"></textarea></label><button data-confirm="¿Confirmas el cierre administrativo auditado?">Forzar cierre</button></form></details>}
 @if(s.Estado==EstadoSesion.Cerrada){<p>Aprobado por @s.Supervisor · @s.Justificacion</p><a asp-action="Reporte" asp-route-tipo="cierre" asp-route-id="@s.Id">Acta de cierre PDF (SSRS)</a>@if(supervisor){<a class="link" asp-action="Contabilidad" asp-route-id="@s.Id">Exportación contable CSV</a>}}
 </section>}
}
@if(vista=="comprobantes"){
 <section><h2>Comprobantes recientes</h2><div class="table-wrap"><table><thead><tr><th>e-NCF</th><th>Cliente</th><th>Total</th><th>Estado DGII</th><th>Acción</th></tr></thead><tbody>@foreach(var f in facturas){<tr><td>@f.ENcf</td><td>@f.Cliente</td><td>@f.Total.ToString("C")</td><td>@f.EstadoDgii @(f.EsPrueba?"(prueba)":"")</td><td><a asp-action="Comprobante" asp-route-id="@f.Id">Ver comprobante</a></td></tr>}</tbody></table></div>@if(facturas.Count==0){<p>No hay comprobantes registrados.</p>}</section>
 <section><h2>Notas de crédito</h2>@if(!supervisor){<form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="solicitar-nota"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><label for="factura-nota">Factura a corregir</label><select id="factura-nota" name="Id">@foreach(var f in facturas.Where(x=>x.Tipo!=TipoECF.E34)){<option value="@f.Id">@f.ENcf · @f.Total.ToString("C")</option>}</select><label for="motivo-nota">Motivo</label><textarea id="motivo-nota" name="Motivo" required maxlength="1000"></textarea><button>Solicitar nota de crédito total</button></form>}
 @foreach(var n in notas){<article><p><strong>@n.Motivo</strong> · Solicitada por @n.Solicitante · @(n.ComprobanteId==null?"Pendiente":"Aprobada")</p>@if(supervisor&&n.ComprobanteId==null){<form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="aprobar-nota"/><input type="hidden" name="Id" value="@n.Id"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><label for="sesion-@n.Id">Sesión abierta del solicitante</label><select id="sesion-@n.Id" name="SesionId">@foreach(var s in sesiones.Where(x=>x.Cajero==n.Solicitante&&x.Estado==EstadoSesion.Abierta)){<option value="@s.Id">@s.Caja · @s.Fecha</option>}</select><button data-confirm="La nota corrige el comprobante. El reembolso debe conciliarse con el proveedor. ¿Continuar?">Aprobar nota</button></form>}</article>}</section>
}
@if(vista=="reportes"){
 <section><h2>Reportes SSRS</h2><p>Los reportes se generan en el servidor institucional de SQL Server Reporting Services.</p>@if(supervisor){<form asp-action="Reporte" method="get"><label for="tipo-reporte">Reporte</label><select name="tipo" id="tipo-reporte"><option value="ingresos">Ingresos por concepto</option><option value="pendientes">Seguimiento DGII</option></select><div class="fields"><div><label for="desde">Desde</label><input type="date" name="desde" id="desde" required/></div><div><label for="hasta">Hasta</label><input type="date" name="hasta" id="hasta" required/></div></div><button>Descargar PDF</button></form>}<p>Para descargar un comprobante o acta de cierre, abre su registro en Comprobantes o Arqueo y cierre.</p></section>
}
@if(vista=="configuracion"&&supervisor){<div class="columns"><section><h2>Registrar versión de tasa</h2><form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="tasa"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/>@foreach(var field in new[]{"Codigo","Nombre","Cuenta","Resolucion"}){<label for="tasa-@field">@field</label><input id="tasa-@field" name="@field" required/>}<label for="precio">Precio sin impuestos</label><input name="Precio" id="precio" type="number" min="0.01" step="0.01" required/><label for="impuesto">Tasa de impuesto (0 a 1)</label><input name="Impuesto" id="impuesto" type="number" min="0" max="1" step="0.000001" value="0"/><label for="vigente-desde">Vigente desde</label><input type="date" name="Desde" id="vigente-desde" required/><label for="vigente-hasta">Vigente hasta</label><input type="date" name="Hasta" id="vigente-hasta" required/><button>Registrar tasa</button></form></section>
 <section><h2>Secuencias autorizadas</h2>@foreach(var seq in secuencias){<p>@seq.Tipo · siguiente @seq.Siguiente / @seq.Hasta · vence @seq.Vence @(seq.Alerta(ViewBag.Hoy)?"⚠ Revisar disponibilidad":"")</p>}<form asp-action="Operar" method="post"><input type="hidden" name="Accion" value="secuencia"/><input type="hidden" name="clave" value="@Guid.NewGuid()"/><label for="secuencia-tipo">Tipo</label><select name="Tipo" id="secuencia-tipo">@foreach(var tipo in Enum.GetValues<TipoECF>()){<option value="@tipo">@tipo</option>}</select><label for="inicio">Primer número autorizado</label><input name="Inicio" id="inicio" type="number" min="1" max="9999999999" required/><label for="fin">Último número autorizado</label><input name="Fin" id="fin" type="number" min="1" max="9999999999" required/><label for="vence">Vencimiento</label><input type="date" name="Hasta" id="vence" required/><button>Registrar rango</button></form></section></div>}
