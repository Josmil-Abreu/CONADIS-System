<!DOCTYPE html><html lang="es-DO"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Caja · CONADIS</title><link rel="stylesheet" href="~/css/caja.css"/></head><body><a class="skip" href="#contenido">Saltar al contenido principal</a><header><div class="brand">CONADIS <span>Gestión de caja</span></div><div>@User.Identity?.Name @if(User.Identity?.IsAuthenticated==true){<form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="secondary">Salir</button></form>}</div></header><main id="contenido">@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}@if(TempData["Mensaje"] is string message){<div class="notice" role="status">@message</div>}@RenderBody()</main><footer>CONADIS · Módulo independiente de caja · Moneda DOP</footer><script src="~/js/caja.js"></script></body></html>