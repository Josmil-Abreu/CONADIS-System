<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="Caja"><DataSourceReference>/CONADIS/Caja/CajaDataSource</DataSourceReference><rd:SecurityType>Integrated</rd:SecurityType></DataSource></DataSources><DataSets><DataSet Name="Datos"><Query><DataSourceName>Caja</DataSourceName><QueryParameters><QueryParameter Name="@Sucursal"><Value>=Parameters!Sucursal.Value</Value></QueryParameter><QueryParameter Name="@SesionId"><Value>=Parameters!SesionId.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT s.Caja,s.Cajero,s.Supervisor,s.Justificacion,s.FirmaCajero,s.FirmaSupervisor,s.CerradaEn,v.Medio,v.Declarado,v.Diferencia FROM caja.SesionCaja s CROSS APPLY (VALUES (N'Efectivo',s.DeclaradoEfectivo,s.DiferenciaEfectivo),(N'Tarjeta',s.DeclaradoTarjeta,s.DiferenciaTarjeta),(N'Transferencia',s.DeclaradoTransferencia,s.DiferenciaTransferencia),(N'En línea',s.DeclaradoEnLinea,s.DiferenciaEnLinea)) v(Medio,Declarado,Diferencia) WHERE s.Id=@SesionId AND s.Sucursal=@Sucursal AND s.Estado=2</CommandText><Timeout>60</Timeout></Query><Fields><Field Name="Caja"><DataField>Caja</DataField></Field><Field Name="Cajero"><DataField>Cajero</DataField></Field><Field Name="Supervisor"><DataField>Supervisor</DataField></Field><Field Name="Medio"><DataField>Medio</DataField></Field><Field Name="Declarado"><DataField>Declarado</DataField></Field><Field Name="Diferencia"><DataField>Diferencia</DataField></Field><Field Name="Justificacion"><DataField>Justificacion</DataField></Field><Field Name="FirmaCajero"><DataField>FirmaCajero</DataField></Field><Field Name="FirmaSupervisor"><DataField>FirmaSupervisor</DataField></Field><Field Name="CerradaEn"><DataField>CerradaEn</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="