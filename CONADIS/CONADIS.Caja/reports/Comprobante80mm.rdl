<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="Caja"><DataSourceReference>/CONADIS/Caja/CajaDataSource</DataSourceReference><rd:SecurityType>Integrated</rd:SecurityType></DataSource></DataSources><DataSets><DataSet Name="Datos"><Query><DataSourceName>Caja</DataSourceName><QueryParameters><QueryParameter Name="@Sucursal"><Value>=Parameters!Sucursal.Value</Value></QueryParameter><QueryParameter Name="@FacturaId"><Value>=Parameters!FacturaId.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT f.*, CASE WHEN f.EsPrueba=1 THEN N'PRUEBA SIN VALIDEZ FISCAL' ELSE CONCAT(N'Estado DGII: ',f.EstadoDgii) END EstadoFiscal FROM caja.Factura f JOIN caja.SesionCaja s ON s.Id=f.SesionCajaId WHERE f.Id=@FacturaId AND s.Sucursal=@Sucursal</CommandText><Timeout>60</Timeout></Query><Fields><Field Name="ENcf"><DataField>ENcf</DataField></Field><Field Name="Cliente"><DataField>Cliente</DataField></Field><Field Name="Documento"><DataField>Documento</DataField></Field><Field Name="Concepto"><DataField>Concepto</DataField></Field><Field Name="Cantidad"><DataField>Cantidad</DataField></Field><Field Name="Precio"><DataField>Precio</DataField></Field><Field Name="Subtotal"><DataField>Subtotal</DataField></Field><Field Name="Itbis"><DataField>Itbis</DataField></Field><Field Name="Total"><DataField>Total</DataField></Field><Field Name="Recibido"><DataField>Recibido</DataField></Field><Field Name="Medio"><DataField>Medio</DataField></Field><Field Name="CodigoSeguridad"><DataField>CodigoSeguridad</DataField></Field><Field Name="EstadoFiscal"><DataField>EstadoFiscal</DataField></Field><Field Name="QrPng"><DataField>QrPng</DataField></Field><Field Name="FacturaReferenciaId"><DataField>FacturaReferenciaId</DataField></Field></Fields></DataSet></DataSets><ReportSections><Repo