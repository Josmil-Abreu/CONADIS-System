<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="Caja"><DataSourceReference>/CONADIS/Caja/CajaDataSource</DataSourceReference><rd:SecurityType>Integrated</rd:SecurityType></DataSource></DataSources><DataSets><DataSet Name="Datos"><Query><DataSourceName>Caja</DataSourceName><QueryParameters><QueryParameter Name="@Sucursal"><Value>=Parameters!Sucursal.Value</Value></QueryParameter><QueryParameter Name="@Desde"><Value>=Parameters!Desde.Value</Value></QueryParameter><QueryParameter Name="@Hasta"><Value>=Parameters!Hasta.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT f.CodigoTasa,f.Concepto,f.Cuenta,SUM(CASE WHEN f.Tipo=34 THEN -f.Subtotal ELSE f.Subtotal END) Subtotal,SUM(CASE WHEN f.Tipo=34 THEN -f.Itbis ELSE f.Itbis END) Impuesto,SUM(CASE WHEN f.Tipo=34 THEN -f.Total ELSE f.Total END) Total FROM caja.Factura f JOIN caja.SesionCaja s ON s.Id=f.SesionCajaId WHERE s.Sucursal=@Sucursal AND s.Fecha&gt;=@Desde AND s.Fecha&lt;=@Hasta GROUP BY f.CodigoTasa,f.Concepto,f.Cuenta ORDER BY f.CodigoTasa</CommandText><Timeout>60</Timeout></Query><Fields><Field Name="CodigoTasa"><DataField>CodigoTasa</DataField></Field><Field Name="Concepto"><DataField>Concepto</DataField></Field><Field Name="Cuenta"><DataField>Cuenta</DataField></Field><Field Name="Subtotal"><DataField>Subtotal</DataField></Field><Field Name="Impuesto"><DataField>Impuesto</DataField></Field><Field Name="Total"><DataField>Total</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="Titulo"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>CONADIS · Ingresos por concepto</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>19pt</FontSize><FontWeight>Bold</FontWeight><Color>#133E5B</Color></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Top>0in</Top><Left>0in</Left><Height>0.5in</Height><Width>7.4in</Width><Style/></Textbox><Textbox Name="Sucursal"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Sucursal: " &amp; Parameters!Sucursal.Value &amp; " · Moneda DOP"</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Top>0.55in</Top><Height>0.3in</Height><Width>7.4in</Width><Style/></Textbox><Tablix Name="Tabla"><TablixBody><TablixColumns><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.4in</Height><TablixCells><TablixCell><CellContents><Textbox Name="H0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>CodigoTasa</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style><BackgroundColor>#133E5B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>5pt</PaddingTop><PaddingBottom>5pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="H1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Concepto</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style><BackgroundColor>#133E5B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>5pt</PaddingTop><PaddingBottom>5pt</PaddingBottom></Style></Textbox></CellContents>