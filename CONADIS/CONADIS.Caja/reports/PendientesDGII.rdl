<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="Caja"><DataSourceReference>/CONADIS/Caja/CajaDataSource</DataSourceReference><rd:SecurityType>Integrated</rd:SecurityType></DataSource></DataSources><DataSets><DataSet Name="Datos"><Query><DataSourceName>Caja</DataSourceName><QueryParameters><QueryParameter Name="@Sucursal"><Value>=Parameters!Sucursal.Value</Value></QueryParameter><QueryParameter Name="@Desde"><Value>=Parameters!Desde.Value</Value></QueryParameter><QueryParameter Name="@Hasta"><Value>=Parameters!Hasta.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT f.ENcf,f.Fecha,f.Total,CASE f.EstadoDgii WHEN 0 THEN N'Pendiente' WHEN 1 THEN N'En proceso' WHEN 3 THEN N'Aceptado condicional' WHEN 4 THEN N'Rechazado' WHEN 5 THEN N'Contingencia' END Estado,f.TrackId,f.MensajeDgii FROM caja.Factura f JOIN caja.SesionCaja s ON s.Id=f.SesionCajaId WHERE s.Sucursal=@Sucursal AND s.Fecha&gt;=@Desde AND s.Fecha&lt;=@Hasta AND f.EstadoDgii&lt;&gt;2 ORDER BY f.Fecha</CommandText><Timeout>60</Timeout></Query><Fields><Field Name="ENcf"><DataField>ENcf</DataField></Field><Field Name="Fecha"><DataField>Fecha</DataField></Field><Field Name="Total"><DataField>Total</DataField></Field><Field Name="Estado"><DataField>Estado</DataField></Field><Field Name="TrackId"><DataField>TrackId</DataField></Field><Field Name="MensajeDgii"><DataField>MensajeDgii</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="Titulo"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>CONADIS · Seguimiento de comprobantes DGII</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>19pt</FontSize><FontWeight>Bold</FontWeight><Color>#133E5B</Color></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Top>0in</Top><Left>0in</Left><Height>0.5in</Height><Width>7.4in</Width><Style/></Textbox><Textbox Name="Sucursal"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Sucursal: " &amp; Parameters!Sucursal.Value &amp; " · Moneda DOP"</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Top>0.55in</Top><Height>0.3in</Height><Width>7.4in</Width><Style/></Textbox><Tablix Name="Tabla"><TablixBody><TablixColumns><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn><TablixColumn><Width>1.2333in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.4in</Height><TablixCells><TablixCell><CellContents><Textbox Name="H0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>ENcf</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style><BackgroundColor>#133E5B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>5pt</PaddingTop><PaddingBottom>5pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="H1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Fecha</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><Style><BackgroundColor>#133E5B</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>5pt</PaddingTop><PaddingBottom>5pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox 