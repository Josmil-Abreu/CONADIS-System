@model RevisionVM
@{
    ViewData["Title"] = "Solicitud: revisión";
    var b = Model.Borrador;
    var id = b.Identificacion;
    var c = b.Contacto;
    var d = b.Diagnostico;
    var cita = b.CitaApoyos;

    var tipo = id?.TipoSolicitud switch
    {
        TipoSolicitud.Renovacion => "Renovación",
        TipoSolicitud.Duplicado => "Duplicado",
        _ => "Primera vez"
    };
    var para = id?.ParaQuien == ParaQuien.Representado ? "Persona que represento" : "Mí mismo";

    var apoyos = new List<string>();
    if (cita?.InterpreteLenguaSenas == true) apoyos.Add("Intérprete de Lengua de Señas");
    if (cita?.AccesoSillaRuedas == true) apoyos.Add("Acceso para silla de ruedas");
    if (cita?.Acompanante == true) apoyos.Add("Acompañante");
    if (!string.IsNullOrWhiteSpace(cita?.OtrosApoyos)) apoyos.Add(cita.OtrosApoyos);

    var avisos = new List<string>();
    if (c?.AvisosSms == true) avisos.Add("SMS");
    if (c?.AvisosEmail == true) avisos.Add("correo electrónico");
}

<h1 class="h2">Revisa tu solicitud antes de enviarla</h1>
<partial name="_PasosSolicitud" model="5" />

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<section class="tarjeta mb-3" aria-labelledby="r1">
    <div class="d-flex justify-content-between"><h2 id="r1" class="h5">Identificación</h2><a asp-action="Identificacion">Cambiar<span class="visually-hidden"> identificación</span></a></div>
    <dl class="row mb-0">
        <dt class="col-sm-3">Solicitud para</dt><dd class="col-sm-9">@para · @tipo</dd>
        <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@id?.Nombres @id?.Apellidos</dd>
        <dt class="col-sm-3">Cédula</dt><dd class="col-sm-9">@VistaHelpers.FormatoCedula(id?.Cedula)</dd>
        <dt class="col-sm-3">Identidad</dt><dd class="col-sm-9">@(id?.IdentidadValidada == true ? "Validada con la JCE" : "Pendiente de validar")</dd>
    </dl>
</section>

<section class="tarjeta mb-3" aria-labelledby="r2">
    <div class="d-flex justify-content-between"><h2 id="r2" class="h5">Contacto</h2><a asp-action="Contacto">Cambiar<span class="visually-hidden"> contacto</span></a></div>
    <dl class="row mb-0">
        <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@c?.Telefono</dd>
        <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@c?.Email</dd>
        <dt class="col-sm-3">Dirección</dt><dd class="col-sm-9">@c?.Sector, @c?.Municipio, @c?.Provincia</dd>
        <dt class="col-sm-3">Avisos</dt><dd class="col-sm-9">@(avisos.Any() ? "Por " + string.Join(" y ", avisos) : "Ninguno")</dd>
    </dl>
</section>

<section class="tarjeta mb-3" aria-labelledby="r3">
    <div class="d-flex justify-content-between"><h2 id="r3" class="h5">Diagnóstico y documentos</h2><a asp-action="Diagnostico">Cambiar<span class="visually-hidden"> diagnóstico</span></a></div>
    <dl class="row mb-0">
        <dt class="col-sm-3">Centro de salud</dt><dd class="col-sm-9">@d?.CentroSalud</dd>
        <dt class="col-sm-3">Certificado</dt><dd class="col-sm-9">N.º @d?.NumeroCertificado del @d?.FechaCertificado?.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Archivos</dt>
        <dd class="col-sm-9">@d?.NombreArchivoCertificado @(d?.NombresOtrosEstudios.Any() == true ? ", " + string.Join(", ", d.NombresOtrosEstudios) : "")</dd>
    </dl>
</section>

<section class="tarjeta mb-3" aria-labelledby="r4">
    <div class="d-flex justify-content-between"><h2 id="r4" class="h5">Cita y apoyos</h2><a asp-action="CitaApoyos">Cambiar<span class="visually-hidden"> cita y apoyos</span></a></div>
    <dl class="row mb-0">
        <dt class="col-sm-3">Centro de valoración</dt><dd class="col-sm-9">@cita?.CentroValoracion</dd>
        <dt class="col-sm-3">Fecha propuesta</dt><dd class="col-sm-9">@cita?.FechaCita?.ToString("dddd dd/MM/yyyy, h:mm tt")</dd>
        <dt class="col-sm-3">Apoyos solicitados</dt><dd class="col-sm-9">@(apoyos.Any() ? string.Join(" · ", apoyos) : "Ninguno")</dd>
    </dl>
</section>

<form asp-action="Enviar" method="post" class="tarjeta">
    <h2 class="h5">Antes de enviar</h2>
    <div class="form-check mb-2">
        <input asp-for="AutorizaDatos" class="form-check-input" data-val="false" />
        <label asp-for="AutorizaDatos" class="form-check-label">
            Autorizo al CONADIS a tratar mis datos de salud para esta solicitud, según la Ley 172-13.
            <a asp-controller="Home" asp-action="Privacidad" target="_blank">Leer el aviso de privacidad</a>
        </label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="DeclaraVeracidad" class="form-check-input" data-val="false" />
        <label asp-for="DeclaraVeracidad" class="form-check-label">Declaro que la información y los documentos entregados son verdaderos.</label>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3">
        <a asp-action="CitaApoyos" class="btn btn-link">Volver al paso 4</a>
        <button type="submit" class="btn btn-primary btn-lg">Enviar solicitud</button>
    </div>
</form>