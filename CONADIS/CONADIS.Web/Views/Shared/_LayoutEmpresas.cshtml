<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CONADIS Portal de Empresas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_BarraAccesibilidad" />

    <header class="encabezado">
        <nav class="navbar navbar-expand-lg" aria-label="Menú del portal de empresas">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="Empresas" asp-controller="Certificaciones" asp-action="Index">
                    <span class="logo" aria-hidden="true">C</span>
                    <span class="lh-sm"><strong>CONADIS</strong><br /><small class="text-muted">Portal de Empresas</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuEmpresas"
                        aria-controls="menuEmpresas" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuEmpresas">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Empresas" asp-controller="Certificaciones" asp-action="Index">Certificaciones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Verificacion" asp-action="Index">Verificar carnets</a></li>
                        <li class="nav-item"><span class="nav-link fw-semibold">@User.Identity?.Name · RNC @User.Rnc()</span></li>
                        <li class="nav-item">
                            <form asp-area="" asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido" class="container py-4" tabindex="-1">
        <partial name="_Mensajes" />
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-4 mt-4">
        <div class="container"><strong>CONADIS</strong> · [Teléfono] · [Correo]</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>