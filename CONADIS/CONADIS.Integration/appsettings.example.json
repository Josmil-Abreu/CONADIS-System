{
  "Integration": {
    "UseMocks": true,
    "PaymentGateway": {
      "BaseUrl": "https://api.payment-provider.com/v1",
      "ApiKey": "pk_test_your_api_key",
      "SecretKey": "sk_test_your_secret_key",
      "TimeoutSeconds": 30,
      "ApiVersion": "v1"
    },
    "DigitalSignature": {
      "BaseUrl": "https://api.dgii.gob.do/v1",
      "CertificatePath": "Certificates/conadis-cert.pfx",
      "CertificatePassword": "your_cert_password",
      "TimeoutSeconds": 45,
      "ApiKey": "dgii_api_key",
      "ApiVersion": "v1"
    },
    "Jce": {
      "BaseUrl": "https://api.jce.gob.do/v1",
      "ApiKey": "jce_api_key",
      "TimeoutSeconds": 20,
      "ApiVersion": "v1"
    },
    "Msp": {
      "BaseUrl": "https://api.msp.gob.do/v1",
      "ApiKey": "msp_api_key",
      "TimeoutSeconds": 20,
      "ApiVersion": "v1"
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "InitialDelayMs": 100,
      "BackoffMultiplier": 2.0
    }
  }
}
