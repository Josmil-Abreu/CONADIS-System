<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Portal Ciudadano (MVC). Las pantallas llaman a CONADIS.Web.Negocio, que habla con
    CONADIS_WebDB (cuentas, borradores) y con Integración (https://localhost:7102) para todo lo demás.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CONADIS.Web.Negocio\CONADIS.Web.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\..\LiberarPuertos.targets" />
</Project>
