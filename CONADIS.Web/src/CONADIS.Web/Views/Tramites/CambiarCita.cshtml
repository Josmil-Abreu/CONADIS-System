@model CambiarCitaVM
@{
    ViewData["Title"] = "Cambiar la fecha de la cita";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h2">Cambiar la fecha de la cita</h1>
        <p class="text-muted">Trámite @Model.NumeroTramite</p>
        <form asp-action="CambiarCita" method="post" class="tarjeta">
            <input type="hidden" asp-for="NumeroTramite" />
            <div class="mb-3">
                <label asp-for="NuevaFecha" class="form-label">Nueva fecha y hora</label>
                <input asp-for="NuevaFecha" class="form-control" />
                <span asp-validation-for="NuevaFecha" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Confirmar nueva fecha</button>
            <a asp-action="Detalle" asp-route-id="@Model.NumeroTramite" class="ms-2">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}