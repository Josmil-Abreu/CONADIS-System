@model IniciarSesionVM
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row g-4">
    <section class="col-lg-6" aria-labelledby="tituloEntrar">
        <div class="tarjeta">
            <h1 id="tituloEntrar" class="h3">Iniciar sesión</h1>

            <button type="button" class="btn btn-outline-dark w-100 mb-3" disabled>Entrar con mi cuenta GOB.do (próximamente)</button>
            <p class="text-center text-muted">o con tu cuenta del portal</p>

            <form asp-action="IniciarSesion" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Cedula" class="form-label">Cédula</label>
                    <input asp-for="Cedula" class="form-control" inputmode="numeric" autocomplete="username" aria-describedby="ayudaCedula" />
                    <div id="ayudaCedula" class="form-text">11 dígitos, con o sin guiones. Ejemplo: 001-0000000-1</div>
                    <span asp-validation-for="Cedula" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label">Contraseña</label>
                    <div class="input-group">
                        <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary" data-mostrar="Contrasena" aria-pressed="false">Mostrar</button>
                    </div>
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>

            <p class="mt-3 mb-1"><a asp-action="OlvideContrasena">Olvidé mi contraseña</a></p>
            <p class="small text-muted mb-0">Por seguridad, tras 5 intentos fallidos la cuenta se bloquea 15 minutos.</p>
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="tituloPrimera">
        <div class="tarjeta mb-3">
            <h2 id="tituloPrimera" class="h4">¿Es tu primera vez?</h2>
            <p>Crea tu cuenta para solicitar el carnet, seguir tus trámites y descargar tu carnet digital.</p>
            <p class="fw-semibold mb-2">Quiero registrarme como</p>
            <div class="d-grid gap-2">
                <a class="btn btn-outline-primary text-start" asp-action="Registro" asp-route-tipo="Titular">Persona con discapacidad (titular)</a>
                <a class="btn btn-outline-primary text-start" asp-action="Registro" asp-route-tipo="Tutor">Tutor o representante legal</a>
                <a class="btn btn-outline-primary text-start" asp-action="Registro" asp-route-tipo="Empresa">Empresa o institución (RNC)</a>
            </div>
        </div>
        <div class="tarjeta">
            <h2 class="h5">¿Solo quieres consultar un trámite?</h2>
            <p>No necesitas cuenta: usa tu número de trámite y tu cédula.</p>
            <a class="btn btn-outline-secondary" asp-controller="Tramites" asp-action="Consultar">Consultar sin cuenta</a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}