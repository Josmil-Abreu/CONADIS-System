<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CONADIS.Web.Negocio: lógica del Portal Ciudadano (sin interfaz gráfica).
      Datos/      -> acceso a CONADIS_WebDB solo con Stored Procedures (copia de la del Core)
      Logging/    -> Log4Net (archivo + tabla Log4NetLog)
      Seguridad/  -> cédula, contraseñas PBKDF2, tokens de un solo uso
      Externos/   -> ClienteSnd: el portal habla SOLO con Integración, nunca con el Core
      Servicios/  -> cuentas, trámites, solicitudes, pagos en línea y borradores
    Las páginas del portal (MVC/Razor) llaman a estos servicios.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CONADIS.Web.Negocio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Reportes RDLC en .NET moderno (el ReportViewer clásico solo existe para .NET Framework) -->
    <PackageReference Include="ReportViewerCore.NETCore" Version="15.1.22" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CONADIS.Web.Pruebas" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los diseños .rdlc viajan dentro de la DLL: GeneradorReportes los lee como recurso incrustado -->
    <EmbeddedResource Include="Reportes\*.rdlc" />
  </ItemGroup>

</Project>
