<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
    CONADIS.Core.Api: la API REST del Core (el "módulo de servicios" del Core).
    Su único cliente es el módulo de Integración, que se identifica con una API key.
    No tiene lógica propia: cada endpoint llama a un servicio de CONADIS.Core.Negocio.
      Controladores/    -> un controlador por área (ciudadanos, pagos, verificación...)
      Contratos/        -> forma del JSON que se recibe
      Seguridad/        -> autenticación por API key
      Infraestructura/  -> manejo centralizado de errores
  -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>CONADIS.Core.Api</RootNamespace>
		<!-- Los comentarios /// de los controladores aparecen como descripción en Swagger -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CONADIS.Core.Negocio\CONADIS.Core.Negocio.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="log4net.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>