@using System.Data
@using CONADIS.Core.Web.Controllers
@model DataTable?
@{ ViewData["Title"] = "Reportes"; }
<h1 class="h3">Reportes</h1>
<p class="text-muted small">Los archivos PDF y Excel se generan con los diseños RDLC del módulo Core. Cada reporte generado queda registrado en la bitácora.</p>
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4"><label for="reporte" class="form-label">Reporte</label>
        <select id="reporte" name="reporte" class="form-select">
            @foreach (var r in ReportesController.Disponibles)
            {
                <option value="@r.Key" selected="@(r.Key == (string?)ViewBag.Reporte)">@r.Value.Titulo</option>
            }
        </select></div>
    <div class="col-md-2"><label for="desde" class="form-label">Desde</label><input id="desde" name="desde" type="date" class="form-control" value="@(((DateOnly)ViewBag.Desde).ToString("yyyy-MM-dd"))" /></div>
    <div class="col-md-2"><label for="hasta" class="form-label">Hasta</label><input id="hasta" name="hasta" type="date" class="form-control" value="@(((DateOnly)ViewBag.Hasta).ToString("yyyy-MM-dd"))" /></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Ver en pantalla</button></div>
    <div class="col-md-1"><button formaction="@Url.Action("Descargar")" name="formato" value="Pdf" class="btn btn-primary w-100" formtarget="_blank">PDF</button></div>
    <div class="col-md-1"><button formaction="@Url.Action("Descargar")" name="formato" value="Excel" class="btn btn-success w-100">Excel</button></div>
</form>
@if (Model is not null)
{
    @if (Model.Rows.Count == 0) { <p class="text-muted">Sin datos en el rango elegido.</p> }
    else
    {
        <table class="table table-striped bg-white tabla-compacta">
            <thead><tr>@foreach (DataColumn col in Model.Columns) { <th>@col.ColumnName</th> }</tr></thead>
            <tbody>
            @foreach (DataRow fila in Model.Rows)
            {
                <tr>@foreach (DataColumn col in Model.Columns) { <td>@fila[col]</td> }</tr>
            }
            </tbody>
        </table>
    }
}
