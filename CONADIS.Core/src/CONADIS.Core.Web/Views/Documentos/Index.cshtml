@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Mis transacciones";
    var u = User.Usuario();
    var verTodos = u?.Rol is Roles.Auditor or Roles.Administrador;
}
<h1 class="h3">@(verTodos ? "Transacciones" : "Mis transacciones")</h1>
<p class="text-muted small">Cada operación registrada en el sistema tiene su comprobante en PDF (con la huella de integridad de la bitácora).</p>
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-2"><label for="desde" class="form-label">Desde</label><input id="desde" name="desde" type="date" class="form-control" value="@(((DateOnly)ViewBag.Desde).ToString("yyyy-MM-dd"))" /></div>
    <div class="col-md-2"><label for="hasta" class="form-label">Hasta</label><input id="hasta" name="hasta" type="date" class="form-control" value="@(((DateOnly)ViewBag.Hasta).ToString("yyyy-MM-dd"))" /></div>
    @if (verTodos)
    {
        <div class="col-md-3"><label for="usuario" class="form-label">Usuario</label><input id="usuario" name="usuario" class="form-control" value="@ViewBag.UsuarioFiltro" /></div>
    }
    <div class="col-md-2"><button class="btn btn-primary w-100">Filtrar</button></div>
    <div class="col-md-2"><a class="btn btn-outline-primary w-100" target="_blank"
        href="@Url.Action(verTodos ? "Descargar" : "MiActividad", verTodos ? "Reportes" : "Documentos", new { reporte = "transacciones", desde = ((DateOnly)ViewBag.Desde).ToString("yyyy-MM-dd"), hasta = ((DateOnly)ViewBag.Hasta).ToString("yyyy-MM-dd"), formato = "Pdf" })">Listado PDF</a></div>
</form>
@if (Model.Rows.Count == 0) { <p class="text-muted">No hay transacciones en el período.</p> }
else
{
    <table class="table table-striped bg-white tabla-compacta small">
        <thead><tr><th>N.º</th><th>Fecha</th><th>Usuario</th><th>Transacción</th><th>Referencia</th><th>Detalle</th><th>Comprobante</th></tr></thead>
        <tbody>
        @foreach (DataRow f in Model.Rows)
        {
            <tr>
                <td>@f["EventoId"]</td><td>@(f["Fecha"] is DateTime d ? d.ToString("dd/MM/yyyy HH:mm") : f["Fecha"])</td><td>@f["Usuario"]</td>
                <td>@f["Accion"]</td><td>@f["Entidad"] @f["EntidadId"]</td><td>@f["Detalle"]</td>
                <td class="text-nowrap">
                    <a asp-action="Comprobante" asp-route-id="@f["EventoId"]" asp-route-formato="Pdf" target="_blank">PDF</a> ·
                    <a asp-action="Comprobante" asp-route-id="@f["EventoId"]" asp-route-formato="Excel">Excel</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
