@model List<CitaAgenda>
@{
    ViewData["Title"] = "Mi agenda";
    var fecha = (DateOnly)ViewBag.Fecha;
}
<h1 class="h3">Agenda de valoración</h1>
<form method="get" class="d-flex gap-2 align-items-end mb-3">
    <div><label for="fecha" class="form-label">Día</label><input id="fecha" name="fecha" type="date" value="@fecha.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <button class="btn btn-outline-primary">Ver</button>
</form>
@if (Model.Count == 0) { <p class="text-muted">No hay citas para este día.</p> }
<table class="table bg-white tabla-compacta">
    <thead><tr><th>Hora</th><th>Expediente</th><th>Persona</th><th>Tipo</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.FechaHora.LocalDateTime.ToString("HH:mm")</td><td>@c.NumeroExpediente</td><td>@c.NombreCompleto</td>
            <td>@(c.Domiciliaria ? "Domiciliaria" : "En centro")</td><td>@c.Estado</td>
            <td>
                <form asp-action="Iniciar" method="post"><input type="hidden" name="expedienteId" value="@c.ExpedienteId" />
                    <button class="btn btn-sm btn-primary">Valorar</button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
