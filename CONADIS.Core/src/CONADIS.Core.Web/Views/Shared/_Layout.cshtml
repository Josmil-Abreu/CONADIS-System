<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CONADIS Interno</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/interno.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#contenido">Saltar al contenido</a>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" asp-controller="Inicio" asp-action="Index">CONADIS · Sistema interno</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        @foreach (var o in Menu.Para(User))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="@o.Controlador" asp-action="Index">@o.Texto</a></li>
                        }
                    </ul>
                    @{ var u = User.Usuario(); }
                    <a class="btn btn-light btn-sm me-3" asp-controller="Documentos" asp-action="MiActividad" asp-route-formato="Pdf" target="_blank"
                       title="Descarga en PDF todo lo que usted hizo en los últimos 30 días">Mi actividad (PDF)</a>
                    <span class="navbar-text me-3 small">@u?.NombreCompleto · @Menu.TextoRol(u?.Rol ?? "")</span>
                    <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                    </form>
                </div>
            }
        </div>
    </nav>
    <main id="contenido" class="container-fluid py-4 px-4">
        @if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success" role="status">@mensaje</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
@if (User.Identity?.IsAuthenticated == true)
{
    <div id="aviso-sesion" class="alert alert-warning position-fixed bottom-0 end-0 m-3 shadow d-none" role="alertdialog" aria-live="assertive" style="z-index:2000;max-width:360px">
        Su sesión se cerrará en 2 minutos por inactividad.
        <button type="button" class="btn btn-sm btn-primary ms-2" onclick="location.reload()">Seguir conectado</button>
    </div>
    <script>
        (function () {
            var minutos = 15;
            setTimeout(function () { document.getElementById('aviso-sesion').classList.remove('d-none'); }, (minutos - 2) * 60000);
            setTimeout(function () { location.href = '/Cuenta/IniciarSesion'; }, minutos * 60000 + 5000);
        })();
    </script>
}
</body>
</html>
