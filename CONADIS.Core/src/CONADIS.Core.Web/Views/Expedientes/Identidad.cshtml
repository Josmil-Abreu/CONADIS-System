@model List<PersonaIdentidadPendiente>
@{ ViewData["Title"] = "Identidad pendiente"; }
<a asp-action="Index" class="small">← Expedientes</a>
<h1 class="h3 mt-2">Identidad pendiente de validar</h1>
<p class="text-muted">Personas que la JCE no pudo validar (servicio caído o datos distintos). Verifique la cédula física antes de aprobar.</p>
@if (Model.Count == 0) { <p>No hay identidades pendientes.</p> }
<table class="table bg-white tabla-compacta align-middle">
    <thead><tr><th>Cédula</th><th>Nombre</th><th>Expediente</th><th>Desde</th><th style="width:40%">Validar</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr class="@(p.RequiereAnalista ? "table-warning" : "")">
            <td>@p.Cedula</td><td>@p.Nombres @p.Apellidos</td><td>@p.NumeroExpediente</td>
            <td>@p.FechaCreacion.LocalDateTime.ToString("dd/MM/yyyy HH:mm")@(p.RequiereAnalista ? " · más de 24 h" : "")</td>
            <td><form asp-action="AprobarIdentidad" method="post" class="d-flex gap-2">
                <input type="hidden" name="personaId" value="@p.PersonaId" />
                <label class="visually-hidden" for="c@(p.PersonaId)">Comentario</label>
                <input id="c@(p.PersonaId)" name="comentario" class="form-control form-control-sm" placeholder="Documento revisado, observaciones" required />
                <button class="btn btn-sm btn-success">Aprobar</button>
            </form></td>
        </tr>
    }
    </tbody>
</table>
