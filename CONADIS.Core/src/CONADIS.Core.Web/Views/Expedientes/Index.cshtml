@model List<ExpedienteResumen>
@{ ViewData["Title"] = "Expedientes"; }
<h1 class="h3">Expedientes</h1>
<form method="get" class="row g-2 align-items-end mb-3" role="search">
    <div class="col-md-5">
        <label for="texto" class="form-label">Número, cédula o nombre</label>
        <input id="texto" name="texto" value="@ViewBag.Texto" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="estado" class="form-label">Estado</label>
        <select id="estado" name="estado" class="form-select">
            <option value="">Todos</option>
            @foreach (var e in Valores.EstadosExpediente)
            {
                <option value="@e" selected="@(e == (string?)ViewBag.Estado)">@e</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Buscar</button></div>
</form>
@if (Model.Count == 0)
{
    <p class="text-muted">Escriba un criterio o elija un estado para buscar.</p>
}
else
{
    <table class="table table-striped table-hover bg-white tabla-compacta">
        <thead><tr><th>Expediente</th><th>Cédula</th><th>Nombre</th><th>Estado</th><th>Tipo / grado</th><th>Centro</th><th>Actualizado</th></tr></thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td><a asp-action="Detalle" asp-route-id="@x.ExpedienteId">@x.NumeroExpediente</a></td>
                <td>@x.Cedula</td><td>@x.NombreCompleto</td><td>@x.Estado</td>
                <td>@x.TipoDiscapacidad @x.GradoDiscapacidad</td><td>@x.Centro</td>
                <td>@x.FechaActualizacion.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
}
