@model List<UsuarioResumen>
@{ ViewData["Title"] = "Administración"; }
<h1 class="h3">Administración</h1>
<partial name="_Pestanas" />
<form method="get" class="d-flex gap-2 mb-3" role="search">
    <label for="texto" class="visually-hidden">Buscar</label>
    <input id="texto" name="texto" value="@ViewBag.Texto" class="form-control w-auto" placeholder="Usuario o nombre" />
    <button class="btn btn-outline-primary">Buscar</button>
</form>
<p><a class="btn btn-primary" asp-action="Editar">Nuevo usuario</a></p>
<table class="table table-striped bg-white tabla-compacta">
    <thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Disciplina</th><th>Centro</th><th>Activo</th><th>Último acceso</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr><td>@u.Username</td><td>@u.NombreCompleto</td><td>@Menu.TextoRol(u.Rol)</td><td>@u.Disciplina</td><td>@u.Centro</td>
            <td>@(u.Activo ? "Sí" : "No")@(u.BloqueadoHasta > DateTimeOffset.Now ? " (bloqueado)" : "")</td>
            <td>@u.UltimoAcceso?.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
            <td><a asp-action="Editar" asp-route-id="@u.UsuarioId">Editar</a></td></tr>
    }
    </tbody>
</table>
