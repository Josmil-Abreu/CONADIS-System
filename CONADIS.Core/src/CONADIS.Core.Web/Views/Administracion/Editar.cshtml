@model CONADIS.Core.Web.Controllers.FormularioUsuario
@{
    var nuevo = Model.UsuarioId is null;
    ViewData["Title"] = nuevo ? "Nuevo usuario" : "Editar usuario";
    var roles = (List<Rol>)ViewBag.Roles;
    var centros = (List<CentroValoracion>)ViewBag.Centros;
}
<h1 class="h3">@ViewData["Title"]</h1>
<partial name="_Pestanas" />
@if (ViewBag.Error is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="row g-4">
<form method="post" asp-action="Editar" class="col-lg-7 bg-white p-3 rounded border">
    <input type="hidden" name="UsuarioId" value="@Model.UsuarioId" />
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label" for="Username">Usuario</label>
            <input class="form-control" id="Username" name="Username" value="@Model.Username" required minlength="3" autocomplete="off" /></div>
        <div class="col-md-6"><label class="form-label" for="NombreCompleto">Nombre completo</label>
            <input class="form-control" id="NombreCompleto" name="NombreCompleto" value="@Model.NombreCompleto" required /></div>
        <div class="col-md-6"><label class="form-label" for="Correo">Correo institucional</label>
            <input class="form-control" type="email" id="Correo" name="Correo" value="@Model.Correo" required /></div>
        <div class="col-md-6"><label class="form-label" for="RolId">Rol</label>
            <select class="form-select" id="RolId" name="RolId" required>
                @foreach (var r in roles) { <option value="@r.RolId" selected="@(r.RolId == Model.RolId)">@Menu.TextoRol(r.Nombre) — @r.Descripcion</option> }
            </select></div>
        <div class="col-md-6"><label class="form-label" for="Disciplina">Disciplina (solo evaluadores)</label>
            <select class="form-select" id="Disciplina" name="Disciplina">
                <option value="">— Ninguna —</option>
                @foreach (var d in new[] { "Medica", "Psicologica", "Social" }) { <option value="@d" selected="@(d == Model.Disciplina)">@d</option> }
            </select></div>
        <div class="col-md-6"><label class="form-label" for="CentroId">Centro de valoración</label>
            <select class="form-select" id="CentroId" name="CentroId">
                <option value="">— Ninguno —</option>
                @foreach (var c in centros) { <option value="@c.CentroId" selected="@(c.CentroId == Model.CentroId)">@c.Nombre (@c.Provincia)</option> }
            </select></div>
        @if (nuevo)
        {
            <div class="col-md-6"><label class="form-label" for="Contrasena">Contraseña inicial</label>
                <input class="form-control" type="password" id="Contrasena" name="Contrasena" required autocomplete="new-password" />
                <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div></div>
        }
        <div class="col-12 form-check ms-2">
            <input class="form-check-input" type="checkbox" id="Activo" name="Activo" value="true" checked="@Model.Activo" />
            <input type="hidden" name="Activo" value="false" />
            <label class="form-check-label" for="Activo">Activo (los usuarios no se borran: se desactivan)</label>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
    </div>
</form>
@if (!nuevo)
{
    <div class="col-lg-5">
        <form method="post" asp-action="Restablecer" class="bg-white p-3 rounded border mb-3">
            <input type="hidden" name="id" value="@Model.UsuarioId" />
            <h2 class="h6">Restablecer contraseña</h2>
            <label class="form-label" for="contrasena">Nueva contraseña</label>
            <input class="form-control mb-2" type="password" id="contrasena" name="contrasena" required autocomplete="new-password" />
            <button class="btn btn-outline-primary">Restablecer</button>
        </form>
        @if (ViewBag.Bloqueado is true)
        {
            <form method="post" asp-action="Desbloquear" class="bg-white p-3 rounded border">
                <input type="hidden" name="id" value="@Model.UsuarioId" />
                <p class="mb-2">El usuario está bloqueado por intentos fallidos.</p>
                <button class="btn btn-warning">Desbloquear</button>
            </form>
        }
    </div>
}
</div>
