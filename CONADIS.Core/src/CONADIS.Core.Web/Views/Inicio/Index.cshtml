@model List<OpcionMenu>
@{
    ViewData["Title"] = "Inicio";
    var u = User.Usuario();
}
<h1 class="h3 mb-1">Bienvenido(a), @u?.NombreCompleto</h1>
<p class="text-muted">@Menu.TextoRol(u?.Rol ?? "")@(u?.Disciplina is { } d ? $" · {d}" : "")</p>
<div class="row g-3">
    @foreach (var o in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <a class="tarjeta tarjeta-opcion" asp-controller="@o.Controlador" asp-action="Index">
                <h2 class="h5">@o.Texto</h2>
                <p class="mb-0 text-muted">@o.Descripcion</p>
            </a>
        </div>
    }
</div>
