@{ ViewData["Title"] = "Entrar al sistema interno"; }
<div class="row justify-content-center">
    <div class="col-sm-8 col-md-6 col-lg-5">
        <div class="tarjeta mt-4">
            <h1 class="h4 mb-3">Personal del CONADIS</h1>
            <p>El sistema interno se abre únicamente desde <strong>CONADIS Inicio</strong>, el programa de login único.</p>
            <ol class="mb-0">
                <li>Abra <strong>CONADIS Inicio</strong> en esta computadora.</li>
                <li>Escriba su usuario y contraseña del personal.</li>
                <li>El sistema interno se abrirá aquí con su sesión y el menú de su rol.</li>
            </ol>
            <p class="small text-muted mt-3 mb-0">Si su sesión venció por inactividad (15 minutos), vuelva a entrar desde CONADIS Inicio.</p>
        </div>
    </div>
</div>
