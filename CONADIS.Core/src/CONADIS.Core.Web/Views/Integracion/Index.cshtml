@using CONADIS.Core.Web.Controllers
@{
    ViewData["Title"] = "Reportes de Integración";
    var desde = ((DateOnly)ViewBag.Desde).ToString("yyyy-MM-dd");
    var hasta = ((DateOnly)ViewBag.Hasta).ToString("yyyy-MM-dd");
}
<h1 class="h3">Reportes de Integración</h1>
<p class="text-muted small">Los genera el módulo de Integración con sus propios diseños RDLC y su propia base de datos; el Core solo los solicita por la API.</p>
<form method="get" asp-action="Descargar" class="row g-2 align-items-end mb-4" target="_blank">
    <div class="col-md-4"><label for="reporte" class="form-label">Reporte</label>
        <select id="reporte" name="reporte" class="form-select">
            @foreach (var r in IntegracionController.Disponibles) { <option value="@r.Key">@r.Value</option> }
        </select></div>
    <div class="col-md-2"><label for="desde" class="form-label">Desde</label><input id="desde" name="desde" type="date" class="form-control" value="@desde" /></div>
    <div class="col-md-2"><label for="hasta" class="form-label">Hasta</label><input id="hasta" name="hasta" type="date" class="form-control" value="@hasta" /></div>
    <div class="col-md-2"><button name="formato" value="Pdf" class="btn btn-primary w-100">PDF</button></div>
    <div class="col-md-2"><button name="formato" value="Excel" class="btn btn-success w-100">Excel</button></div>
</form>
<h2 class="h5">Comprobante de una transacción</h2>
<form method="get" asp-action="Comprobante" class="row g-2 align-items-end" target="_blank">
    <div class="col-md-3"><label for="id" class="form-label">N.º de transacción (bitácora)</label><input id="id" name="id" type="number" min="1" class="form-control" required /></div>
    <div class="col-md-2"><button name="formato" value="Pdf" class="btn btn-outline-primary w-100">Ver comprobante</button></div>
</form>
